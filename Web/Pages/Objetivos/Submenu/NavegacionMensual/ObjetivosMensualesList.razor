@page "/objetivosMensuales/lista"
@using Domain.DTOs.Responses
@using Domain.Enums
@using Web.Pages.Objetivos.Operaciones
@inject IRequestService RequestService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Objetivos Mensuales — Lista</PageTitle>

<MudStack Class="mb-3" Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.h5" Class="text-vita-dark fw-bold">
        Objetivos Mensuales por Cabaña
    </MudText>

    <MudButton Class="btn-vita"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Nav.NavigateTo("/objetivosMensuales"))">
        Volver a Cabañas
    </MudButton>
</MudStack>

@if (_items is null)
{
    <div class="d-flex justify-center align-center" style="height:60vh;"><Loading /></div>
}
else if (!_items.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No hay objetivos mensuales cargados.
    </MudAlert>
}
else
{
    <MudTable Class="table-full" Items="_ordenados" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Cabaña</MudTh>
            <MudTh>Año</MudTh>
            <MudTh>Mes</MudTh>
            <MudTh>Meta Ocupación %</MudTh>
            <MudTh>Fecha Creación</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh Class="col-acciones">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.NombreCabaña</MudTd>
            <MudTd>@context.Año</MudTd>
            <MudTd>@MesNombre(context.Mes ?? 0)</MudTd>
            <MudTd>@($"{context.MetaOcupacion:0.##}%")</MudTd>
            <MudTd>@context.FechaCreacion.ToString("dd/MM/yyyy")</MudTd>

            <MudTd>
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Label="true">Activo</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Label="true">Inactivo</MudChip>
                }
            </MudTd>

            <MudTd Class="col-acciones">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Default"
                               Style="color:#4a4a4a"
                               OnClick="@(() => Edit(context))"
                               Size="Size.Small" />
            </MudTd>
        </RowTemplate>

        <PagerContent><MudTablePager /></PagerContent>
    </MudTable>
}

@code {
    private List<ObjetivoResponseDto>? _items;
    private IEnumerable<ObjetivoResponseDto>? _ordenados;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var mensuales = await RequestService.GetAsync<List<ObjetivoResponseDto>>("api/objetivos/mensuales");
            _items = mensuales ?? new List<ObjetivoResponseDto>();

            _ordenados = _items
                .OrderBy(o => o.NombreCabaña)
                .ThenByDescending(o => o.Año)
                .ThenBy(o => o.Mes ?? int.MaxValue);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar objetivos mensuales: {ex.Message}", Severity.Error);
        }
    }

    private async Task Edit(ObjetivoResponseDto objetivo)
    {
        var parameters = new DialogParameters { ["Objetivo"] = objetivo };
        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await DialogService.ShowAsync<EditObjetivoMensualCabaña>("Editar objetivo mensual", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await OnInitializedAsync(); 
            Snackbar.Add("Objetivo mensual actualizado correctamente.", Severity.Success);
        }
    }

    private static string MesNombre(int mes)
    {
        string[] nombres = { "Enero","Febrero","Marzo","Abril","Mayo","Junio",
                             "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre" };
        return (mes >= 1 && mes <= 12) ? nombres[mes - 1] : "-";
    }
}
