@page "/objetivosMensuales/{idCabaña:int}/años"
@using Domain.DTOs.Responses
@inject IRequestService RequestService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Objetivos mensuales – Años</PageTitle>

<MudStack Class="mb-2" Row="true" Justify="Justify.FlexStart">
    <MudText Typo="Typo.h5" Class="text-vita-dark fw-bold">
        @($"Cabaña {_cabaña?.Nombre ?? "—"} – Años disponibles")
    </MudText>
</MudStack>

<MudStack Row="true" Class="mb-3" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
    <MudButton Class="btn-vita"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.ListAlt"
               OnClick="@(() => Nav.NavigateTo($"/objetivosMensuales/lista"))">
        Ver objetivos mensuales
    </MudButton>
    <MudButton Class="btn-vita"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Nav.NavigateTo("/objetivosMensuales"))">
        Volver a cabañas
    </MudButton>
</MudStack>

@if (_años is null)
{
    <div class="d-flex justify-center align-center" style="height: 60vh;">
        <Loading />
    </div>
}
else if (_años.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No hay años disponibles para esta cabaña.
    </MudAlert>
}
else
{
    <MudTable Items="_años" Hover="true" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh>Año</MudTh>
            <MudTh Class="col-acciones">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Año">@context</MudTd>
            <MudTd Class="col-acciones">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.TouchApp"
                           Class="btn-accion"
                           OnClick="@(() => IrAMeses(context))">
                    Seleccionar
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public int idCabaña { get; set; }

    private CabañaResponseDto? _cabaña;
    private List<int>? _años;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cabañas = await RequestService.GetAsync<List<CabañaResponseDto>>("api/cabañas");
            _cabaña = cabañas?.FirstOrDefault(c => c.Id == idCabaña);

            _años = await RequestService.GetAsync<List<int>>($"api/objetivos/mensuales/cabaña/{idCabaña}/years")
                    ?? new List<int>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private void IrAMeses(int año)
    {
        Nav.NavigateTo($"/objetivosMensuales/{idCabaña}/{año}/meses?nombreCabaña={_cabaña?.Nombre}");
    }

    private void VerObjetivosMensuales(int año)
    {
        Nav.NavigateTo($"/objetivosMensuales/{idCabaña}/{año}/lista");
    }
}